# PostgreSQL service environment (copy to .env.db, which is git-ignored). Placeholders only:
# never commit real values. The api reads DATABASE_URL from .env.api and must use the same
# user, password and database, e.g. postgresql://pp:<password>@db:5432/prestasiplus
POSTGRES_DB=prestasiplus
POSTGRES_USER=pp
POSTGRES_PASSWORD=change-me-local-only
