+// @vitest-environment jsdom
+// REQ-B-055: every stimulus of a group reaches the builder (Tambah soalan unit, Paparan murid drawer) and one rule names a group.
+import { flushPromises, mount, type VueWrapper } from '@vue/test-utils'
+import { createPinia, setActivePinia } from 'pinia'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createMemoryHistory, createRouter } from 'vue-router'
+
+import PaperQuestionOps from '../admin/builder/components/PaperQuestionOps.vue'
+import StudentViewDrawer from '../admin/builder/components/StudentViewDrawer.vue'
+import { groupLabelOf } from '../admin/builder/domain/stimulus'
+import PaperEditorPage from '../admin/papers/PaperEditorPage.vue'
+import type { AdminPaper, PaperEditorData } from '../domain/admin-types'
+import { editorGroupLabel, groupLabel, joinStimulusLabels } from '../lib/stimulus-data'
+
+const h = vi.hoisted((): { server: unknown } => ({ server: undefined }))
+vi.mock('../server/client', () => ({
+  bijakServer: () => h.server,
+  bijakAdminServer: () => h.server,
+}))
+
+const st = (id: string, label: string, extra: object = {}) => ({ id, kind: 'diagram', label, alt: label, ...extra })
+
+describe('one group-label rule (three helpers used to disagree)', () => {
+  const two = [st('a', 'Rajah 1'), st('b', 'Petikan A', { kind: 'passage', text: 'x' })]
+  it('editorGroupLabel, groupLabel and the builder groupLabelOf give the same label for the same stimuli', () => {
+    expect(joinStimulusLabels(two)).toBe('Rajah 1 dan Petikan A')
+    expect(editorGroupLabel({ stimuli: two as never })).toBe('Rajah 1 dan Petikan A')
+    expect(groupLabel(two as never)).toBe('Rajah 1 dan Petikan A')
+    expect(groupLabelOf({ stimuli: two })).toBe('Rajah 1 dan Petikan A')
+    // blank labels are skipped by all of them; an older server sends only `stimulus`
+    const blank = [st('a', ' '), st('b', 'Jadual 1')]
+    expect(editorGroupLabel({ stimuli: blank as never })).toBe('Jadual 1')
+    expect(groupLabelOf({ stimuli: blank })).toBe('Jadual 1')
+    expect(groupLabelOf({ stimulus: st('s', 'Rajah 9') })).toBe('Rajah 9')
+  })
+  it('only the chip fallback differs, on purpose: no label at all is "" in the editor and "Rajah" on the pupil chip', () => {
+    expect(editorGroupLabel({})).toBe('')
+    expect(groupLabelOf({ stimuli: [] })).toBe('')
+    expect(groupLabel([st('a', '')] as never)).toBe('Rajah')
+  })
+})
+
+describe('Paparan murid drawer shows EVERY stimulus of a group, in order', () => {
+  const q = (id: string, n: number) => ({ id, number: n, marks: 1, preview: `Soalan ${id}` })
+  const view = (units: unknown[]) =>
+    ({ title: 'Set', subject: 'MAT', subjectName: 'Matematik', kertas: 2, year: 2026, code: '1449/2', durationMin: 150, instructions: [], reference: [], questionCount: 3, marks: 3, sections: [{ label: 'Bahagian A', instruction: '', marks: 3, units }] }) as never
+  let w: VueWrapper | null = null
+  afterEach(() => {
+    w?.unmount()
+    w = null
+    document.body.innerHTML = ''
+  })
+  async function open(units: unknown[]): Promise<void> {
+    w = mount(StudentViewDrawer, { props: { view: view(units), open: true }, attachTo: document.body })
+    await flushPromises()
+  }
+  const panels = () => [...document.querySelectorAll('[data-testid="student-stimulus"]')]
+  it('three stimuli give three panels in group order; an older server (only `stimulus`) gives one; a solo question none', async () => {
+    const three = [st('s1', 'Rajah 1'), st('s2', 'Petikan A', { kind: 'passage', text: 'bb' }), st('s3', 'Jadual 1')]
+    await open([
+      { groupId: 'g3', stimulus: three[0], stimuli: three, questions: [q('a', 1), q('b', 2)] },
+      { groupId: 'g1', stimulus: st('s9', 'Rajah 9'), questions: [q('c', 3)] },
+      { questions: [q('d', 4)] },
+    ])
+    expect(panels()).toHaveLength(4) // 3 + 1 + 0
+    expect(panels().map((p) => ['Rajah 1', 'Petikan A', 'Jadual 1', 'Rajah 9'].filter((l) => p.textContent?.includes(l)).join('|'))).toEqual(['Rajah 1', 'Petikan A', 'Jadual 1', 'Rajah 9'])
+    // every question is still shown once
+    expect(document.querySelectorAll('[data-testid^="student-q-"]')).toHaveLength(4)
+  })
+})
+
+describe('Tambah soalan (T10 addOpsUnit) keeps every stimulus of the added group', () => {
+  let wrapper: VueWrapper | null = null
+  beforeEach(() => {
+    setActivePinia(createPinia())
+    vi.stubGlobal('matchMedia', (query: string) => ({ matches: false, media: query, addEventListener() {}, removeEventListener() {} }))
+    const paper = {
+      id: 'p1', title: 'K2', subject: 'MAT', kertas: 2, year: 2026, code: '1449/2', durationMin: 90, instructions: [], status: 'draf', createdAt: 1, updatedAt: 1,
+      sections: [{ id: 's1', label: 'Bahagian A', markBudget: 2, questionCount: 2, rule: { type: 'all' }, questionIds: [] }],
+    } as unknown as AdminPaper
+    h.server = { getPaperEditor: vi.fn().mockResolvedValue({ paper, blueprint: null, questions: [], groups: [] } satisfies PaperEditorData) }
+  })
+  afterEach(() => {
+    wrapper?.unmount()
+    wrapper = null
+    document.body.innerHTML = ''
+    vi.unstubAllGlobals()
+  })
+  async function render(): Promise<VueWrapper> {
+    const stub = { template: '<i/>' }
+    const router = createRouter({
+      history: createMemoryHistory(),
+      routes: [
+        { path: '/admin/spm/kertas/:id', name: 'm28.admin.papers.edit', component: PaperEditorPage },
+        { path: '/admin/spm/kertas', name: 'm28.admin.papers', component: stub },
+        { path: '/admin/spm/semakan', name: 'm28.admin.review', component: stub },
+        { path: '/admin/spm/kontrak/:subjek/:kertas', name: 'm28.admin.kontrak.edit', component: stub },
+        { path: '/:p(.*)*', component: stub },
+      ],
+    })
+    await router.push('/admin/spm/kertas/p1')
+    wrapper = mount(PaperEditorPage, { global: { plugins: [router] }, attachTo: document.body })
+    await flushPromises()
+    return wrapper
+  }
+  const unit = (gid: string, stimuli: unknown[], extra: object = {}) => ({
+    groupId: gid,
+    questionIds: [`${gid}a`, `${gid}b`],
+    questions: [`${gid}a`, `${gid}b`].map((id) => ({ id, groupId: gid, preview: `Soalan ${id}`, marks: 1, kind: 'objektif', topic: 'T', status: 'approved', kertas: 2, subject: 'MAT' })),
+    marks: 2, eligible: true, reasons: [], placed: false,
+    ...(stimuli.length ? { stimulus: stimuli[0] } : {}),
+    stimuli,
+    ...extra,
+  })
+  it.each([
+    [0, [], 'Kumpulan rangsangan · 2 soalan'],
+    [1, [st('a', 'Rajah 1')], 'Kumpulan rangsangan Rajah 1 · 2 soalan'],
+    [3, [st('a', 'Rajah 1'), st('b', 'Petikan A'), st('c', 'Jadual 1')], 'Kumpulan rangsangan Rajah 1 dan Petikan A dan Jadual 1 · 2 soalan'],
+  ])('a group with %i stimuli added through the Tambah soalan block is one labelled unit', async (_n, stimuli, text) => {
+    const w = await render()
+    w.findComponent(PaperQuestionOps).vm.$emit('add', 's1', unit('gx', stimuli))
+    await flushPromises()
+    expect(w.get('[data-testid="unit-group-gx"]').text()).toContain(text)
+    expect(w.findAll('[data-testid^="unit-group-"]')).toHaveLength(1)
+  })
+})
