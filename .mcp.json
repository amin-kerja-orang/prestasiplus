{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "msedge"
      ]
    },
    "playwright2": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@latest",
        "--isolated",
        "--output-dir",
        ".playwright-mcp/lane2",
        "--browser",
        "msedge"
      ]
    },
    "playwright3": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@latest",
        "--isolated",
        "--output-dir",
        ".playwright-mcp/lane3",
        "--browser",
        "msedge"
      ]
    },
    "nuxt-ui": {
      "type": "http",
      "url": "https://ui.nuxt.com/mcp"
    }
  }
}
