// Question workflow tables (BE-10, owner module M04, lane PC-5). Conventions:
// docs/architecture/v2-backend-plan.md section 14.2; data model section 3.4 (question_status_events,
// question_reports, question_imports, quality_audits, source_papers).
//
// Hand-written in migration 0017_question_workflow: identity columns (GENERATED ALWAYS), CHECK
// constraints (enums are text + check, English codes), foreign keys. The foreign keys are in the
// migration SQL only, not as Prisma relations, so this file never has to edit identity.prisma,
// files.prisma or the curriculum schema.
//
// `question_id` columns are plain bigint WITHOUT a foreign key: the `questions` table belongs to
// BE-09 (migration 0011), which is merged separately and may not exist when 0017 is applied. BE-09
// or a later card may add the FK with its own migration (G-12). The service treats an unknown id as
// 404 through `QuestionBankPort`, never through a constraint.
//
// Only `question_reports` can receive .cloud rows (open reports are exported, data model 3.7), so
// only it has `legacy_source` / `legacy_id` and is listed in `migratable-models.json`. The other
// tables are not migrated (data model 3.4 "no LEG"); the .cloud `source_papers` are archived.

/// Identity and rights register of a paper, and the unit of takedown (AC-17.3). OWN-2: the upload
/// event is `intake_batches` (BE-37), which points at one row here.
///
/// `natural_key` (BE-30 backfill, confirm in the PR): lower-case, trimmed values joined with `|` in
/// this fixed order, an absent part left empty: `<subject code>|<year>|<exam_board>|<kertas>|<exam_type>`,
/// for example `matematik|2023|lpm|k2|sebenar`. Unique when present: it blocks "same paper already
/// imported" at upload (AC-06.4).
/// `content_hash` (BE-30 backfill): lower-case hex SHA-256 of the paper's normalised text (NFC, lower
/// case, every run of whitespace collapsed to one space, trimmed), so a re-scan of the same paper
/// matches although the file bytes differ. `file_hash` is the SHA-256 of the original file bytes.
model SourcePaper {
  id                 BigInt    @id @default(autoincrement())
  naturalKey         String?   @map("natural_key")
  contentHash        String?   @map("content_hash")
  fileHash           String?   @map("file_hash")
  /// FK subjects(id) ON DELETE SET NULL (migration SQL).
  subjectId          BigInt?   @map("subject_id")
  /// Printed label kept: K1, K2, P1, ...
  kertas             String?
  paperCode          String?   @map("paper_code")
  year               Int?      @db.SmallInt
  examBoard          String?   @map("exam_board")
  /// sebenar, percubaan, modul, topikal, latihan (check constraint).
  examType           String?   @map("exam_type")
  setLabel           String?   @map("set_label")
  /// lpm_official, state_trial, school, publisher, teacher_own, ai_variant (check constraint).
  sourceKind         String?   @map("source_kind")
  /// own, school, official_lpm, third_party, unclear (check constraint). The declaration is mandatory at upload.
  rightsStatus       String    @default("unclear") @map("rights_status")
  /// Admin Pusat decision for third_party (AC-17.2).
  rightsDecisionNote String?   @map("rights_decision_note")
  /// FK users(id) ON DELETE SET NULL (migration SQL).
  rightsDecidedById  BigInt?   @map("rights_decided_by_id")
  rightsDecidedAt    DateTime? @map("rights_decided_at") @db.Timestamptz(6)
  /// Set when every question of this source was archived with archive_reason source_takedown.
  takedownAt         DateTime? @map("takedown_at") @db.Timestamptz(6)
  /// FK users(id) ON DELETE SET NULL (migration SQL).
  takedownById       BigInt?   @map("takedown_by_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([naturalKey], map: "uq_source_papers_natural_key")
  @@index([fileHash], map: "ix_source_papers_file_hash")
  @@index([contentHash], map: "ix_source_papers_content_hash")
  @@index([subjectId], map: "ix_source_papers_subject_id")
  @@map("source_papers")
}

/// Append-only (G-17): rows are inserted, never updated or deleted by code. One row per status
/// transition, written in the same transaction as the change (BE-10 AC 1).
model QuestionStatusEvent {
  id            BigInt   @id @default(autoincrement())
  /// No FK (BE-09 owns `questions`).
  questionId    BigInt   @map("question_id")
  versionNo     Int      @map("version_no")
  /// draft, review, approved, archived, or legacy published (history rows keep it); null for creation (check constraint).
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  /// FK users(id) ON DELETE SET NULL; null when the system acts (for example a takedown or "superseded").
  actorUserId   BigInt?  @map("actor_user_id")
  /// RoleCode text of the actor.
  actorRole     String?  @map("actor_role")
  /// Mandatory for return to Draf, withdraw and restore (service rule).
  reason        String?
  /// The "Jawapan berubah" audit flag (AC-13.4).
  answerChanged Boolean  @default(false) @map("answer_changed")
  /// No FK yet (BE-36 owns `ai_extraction_runs`).
  aiRunId       BigInt?  @map("ai_run_id")
  requestId     String?  @map("request_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([questionId, createdAt], map: "ix_question_status_events_question_id_created_at")
  @@index([actorUserId], map: "ix_question_status_events_actor_user_id")
  @@map("question_status_events")
}

/// A student's report of a question (BR-M04-11 to 16). One report per student per question version.
model QuestionReport {
  id                BigInt    @id @default(autoincrement())
  /// No FK (BE-09 owns `questions`).
  questionId        BigInt    @map("question_id")
  /// The version the student saw (AC-18.2, AC-19.2).
  questionVersionNo Int       @map("question_version_no")
  /// mcq or structured (check constraint); decides the reason set and the deactivation rule.
  questionType      String    @default("mcq") @map("question_type")
  /// FK users(id) ON DELETE SET NULL (migration SQL).
  reporterId        BigInt?   @map("reporter_id")
  /// Codes of E-report_reason (check constraint): wrong_answer, confusing_question, wrong_options,
  /// missing_options, duplicate, typo, other, outdated. At least one.
  reasons           String[]
  /// At most 500 characters (check constraint); never sent to an AI service.
  comment           String?
  /// spm, structured_attempt, latihan, revision, teacher_databank, quiz, papan_bijak (check constraint).
  source            String
  /// uuid of `practice_sessions` (BE-12); no FK yet.
  practiceSessionId String?   @map("practice_session_id") @db.Uuid
  /// uuid of `exam_attempts` the pupil reported from (R1-T42; FK `fk_question_reports_attempt_id` ON DELETE SET NULL, NOT VALID, migration SQL).
  /// The server checks the attempt is the reporter's and holds the question.
  attemptId         String?   @map("attempt_id") @db.Uuid
  /// The paper of that attempt (R1-T42; FK papers(id) ON DELETE SET NULL, migration SQL). Always taken from the attempt, never from the client.
  paperId           BigInt?   @map("paper_id")
  /// Snapshot "title (paper code)" of the paper at filing time (at most 200 characters, check), so the queue still names a paper that was deleted.
  paperLabel        String?   @map("paper_label")
  /// Free session reference of the mock (1 to 64 of letters, digits, . _ : -); not a uuid.
  quizSessionRef    String?   @map("quiz_session_ref")
  /// Room code of the mock (same pattern).
  roomCode          String?   @map("room_code")
  /// Source set label of the mock (null until a source exists).
  sourceSet         String?   @map("source_set")
  /// pending, reviewed, fixed, dismissed (check constraint); BM Menunggu, Disemak, Diperbaiki, Ditolak.
  status            String    @default("pending")
  /// At most 1000 characters (check constraint).
  adminNotes        String?   @map("admin_notes")
  /// FK users(id) ON DELETE SET NULL (migration SQL).
  resolvedById      BigInt?   @map("resolved_by_id")
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// The version that fixed it (AC-19.3).
  fixedInVersionNo  Int?      @map("fixed_in_version_no")
  /// Written while an admin is in Mod Pelajar (G-07).
  isTest            Boolean   @default(false) @map("is_test")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacySource      String?   @map("legacy_source")
  legacyId          String?   @map("legacy_id")

  @@unique([reporterId, questionId, questionVersionNo], map: "uq_question_reports_reporter_question_version")
  @@unique([legacySource, legacyId], map: "uq_question_reports_legacy")
  @@index([status, createdAt], map: "ix_question_reports_status_created_at")
  @@index([questionId], map: "ix_question_reports_question_id")
  @@index([paperId], map: "ix_question_reports_paper_id")
  @@index([reporterId, createdAt], map: "ix_question_reports_reporter_id_created_at")
  @@map("question_reports")
}

/// One Excel/CSV import run (admin and Guru). PDF and AI imports are BE-38 and are not stored here.
model QuestionImport {
  id                      BigInt   @id @default(autoincrement())
  fileName                String   @map("file_name")
  /// The template is versioned (AC-02.1); an old version is refused (AC-02.3).
  templateVersion         String?  @map("template_version")
  importedCount           Int      @default(0) @map("imported_count")
  failedCount             Int      @default(0) @map("failed_count")
  /// `[{ "row": 3, "message": "Baris tidak lengkap." }]` (mock `ImportRun.failures`).
  failures                Json     @default("[]") @db.JsonB
  /// FK subjects(id) ON DELETE SET NULL (migration SQL).
  defaultSubjectId        BigInt?  @map("default_subject_id")
  /// FK education_levels(id) ON DELETE SET NULL (migration SQL).
  defaultEducationLevelId BigInt?  @map("default_education_level_id")
  /// 1 to 5, the legacy scale of the mock (OQ-DM-20).
  defaultDifficulty       Int?     @map("default_difficulty") @db.SmallInt
  /// FK users(id) ON DELETE SET NULL (migration SQL).
  createdById             BigInt?  @map("created_by_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "ix_question_imports_created_at")
  @@index([createdById], map: "ix_question_imports_created_by_id")
  @@map("question_imports")
}

/// One quality audit run (append-only run log, OQ-DM-21). `lastAuditAt` of the dashboard is the
/// newest `finished_at`.
model QualityAudit {
  id           BigInt    @id @default(autoincrement())
  /// FK users(id) ON DELETE SET NULL (migration SQL).
  runById      BigInt?   @map("run_by_id")
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Questions whose score changed in this run (mock `auditRuntimeRows` count).
  findingCount Int?      @map("finding_count")
  /// Questions scored in this run.
  scoredCount  Int?      @map("scored_count")
  /// Mean score of the scored questions, 0 to 100.
  averageScore Float?    @map("average_score")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([finishedAt], map: "ix_quality_audits_finished_at")
  @@map("quality_audits")
}

/// BE-10-owned (not in the data model; see deviations): the score of a question from the newest audit
/// run (SRS 6.12 `score(q)`), so the dashboard reads stored scores like the mock.
model QuestionQualityScore {
  id         BigInt   @id @default(autoincrement())
  /// One row per question; no FK (BE-09 owns `questions`).
  questionId BigInt   @map("question_id")
  /// 0 to 100 (check constraint).
  score      Int      @db.SmallInt
  /// cemerlang 76-100, baik 51-75, lemah 26-50, kritikal 0-25 (check constraint, BR-M04-21).
  bucket     String
  /// FK quality_audits(id) ON DELETE SET NULL (migration SQL).
  auditId    BigInt?  @map("audit_id")
  scoredAt   DateTime @default(now()) @map("scored_at") @db.Timestamptz(6)

  @@unique([questionId], map: "uq_question_quality_scores_question_id")
  @@index([bucket], map: "ix_question_quality_scores_bucket")
  @@index([score], map: "ix_question_quality_scores_score")
  @@map("question_quality_scores")
}

/// BE-10-owned (not in the data model; see deviations): an admin resolved a question in the diagram
/// audit, either by uploading the missing image or by dismissing the flag. A resolved question no
/// longer "needs a diagram" (mock `needsDiagram: false`).
model DiagramAuditResolution {
  id           BigInt   @id @default(autoincrement())
  /// mcq or structured (check constraint): the audit list the row came from.
  kind         String
  /// No FK (BE-09 owns `questions`).
  questionId   BigInt   @map("question_id")
  /// image or dismissed (check constraint).
  resolution   String
  /// FK files(id) ON DELETE SET NULL (migration SQL); set when resolution = image.
  fileId       BigInt?  @map("file_id")
  /// FK users(id) ON DELETE SET NULL (migration SQL).
  resolvedById BigInt?  @map("resolved_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([kind, questionId], map: "uq_diagram_audit_resolutions_kind_question_id")
  @@map("diagram_audit_resolutions")
}

/// BE-10-owned (the data model says "no table", but the mock keeps this state and BE-09 has no home
/// for it; see deviations): the AI master notes shown in the admin review list (BR-M04-23).
model MasterNote {
  id              BigInt   @id @default(autoincrement())
  /// No FK (BE-09 owns `questions`).
  questionId      BigInt   @map("question_id")
  /// Free text; shown as "-" when null.
  chapterLabel    String?  @map("chapter_label")
  model           String
  tokens          Int      @default(0)
  confidence      Float    @default(0)
  noteText        String   @map("note_text")
  trapText        String   @default("") @map("trap_text")
  flagged         Boolean  @default(false)
  teacherApproved Boolean  @default(false) @map("teacher_approved")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([questionId], map: "ix_master_notes_question_id")
  @@index([flagged], map: "ix_master_notes_flagged")
  @@index([teacherApproved], map: "ix_master_notes_teacher_approved")
  @@map("master_notes")
}
