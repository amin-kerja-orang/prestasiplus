// Classes and teacher profile tables (BE-17, owner module M10). Conventions: docs/architecture/v2-backend-plan.md
// section 14.2, data model section 3.9. BE-18 (missions, question sets) adds its models to this file later.
// Not expressible in Prisma and written by hand in migration 0015_classes: identity columns (GENERATED ALWAYS),
// CHECK constraints (enums are text + check), the case-insensitive unique index on classrooms.join_code and the
// foreign keys to tables owned by other modules.
//
// Foreign keys to users, schools, subjects and education_levels exist in the database (migration 0015) but are
// NOT declared as Prisma relations here: a relation needs a back-relation field in the other owner's schema file
// (identity.prisma, schools.prisma, curriculum.prisma), which this card must not edit (parallel cards edit the
// same lines). The repository therefore reads those tables with separate batch lookups, never with `include`.

/// A class. One table for both kinds: `classroom` (created by a teacher, has `teacher_id` and a join code) and
/// `school_class` (managed by the school, no teacher). The level slug (`tahun-1` ... `tingkatan-5`) is derived from
/// `education_levels.grade`, never stored.
model Classroom {
  id               BigInt   @id @default(autoincrement())
  /// classroom, school_class (check constraint).
  kind             String   @default("classroom")
  name             String
  /// users.id of the owning teacher; null for a school class (or an orphaned class after the teacher is deleted).
  teacherId        BigInt?  @map("teacher_id")
  schoolId         BigInt?  @map("school_id")
  /// null = "Tiada Subjek".
  subjectId        BigInt?  @map("subject_id")
  educationLevelId BigInt   @map("education_level_id")
  academicYear     Int      @map("academic_year") @db.SmallInt
  description      String?
  /// Students join with it. Unique ignoring case (index on upper(join_code)); null for a migrated class without a code.
  joinCode         String?  @map("join_code")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacySource     String?  @map("legacy_source")
  legacyId         String?  @map("legacy_id")

  enrolments Enrolment[]

  @@unique([legacySource, legacyId], map: "uq_classrooms_legacy")
  @@index([teacherId, createdAt], map: "ix_classrooms_teacher_id_created_at")
  @@index([schoolId, isActive], map: "ix_classrooms_school_id_is_active")
  @@index([subjectId], map: "ix_classrooms_subject_id")
  @@index([educationLevelId], map: "ix_classrooms_education_level_id")
  @@map("classrooms")
}

/// One student in one class (.cloud `classroom_student`). Removing a student sets `status` to `removed` and keeps the
/// row (history); joining again reactivates it. `is_test` marks rows written under Mod Pelajar: they are excluded from
/// every roster and count.
model Enrolment {
  id           BigInt   @id @default(autoincrement())
  classroomId  BigInt   @map("classroom_id")
  studentId    BigInt   @map("student_id")
  /// active, removed (check constraint).
  status       String   @default("active")
  /// code, teacher, school_admin, complimentary (check constraint).
  source       String   @default("code")
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  isTest       Boolean  @default(false) @map("is_test")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacySource String?  @map("legacy_source")
  legacyId     String?  @map("legacy_id")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade, map: "fk_enrolments_classroom_id")

  @@unique([classroomId, studentId], map: "uq_enrolments_classroom_id_student_id")
  @@unique([legacySource, legacyId], map: "uq_enrolments_legacy")
  @@index([studentId, status], map: "ix_enrolments_student_id_status")
  @@index([classroomId, status], map: "ix_enrolments_classroom_id_status")
  @@map("enrolments")
}

/// Teaching details of a teacher (.cloud `users.teaching_*`). `bio` stays on users and the school on users.school_id.
model TeacherProfile {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @map("user_id")
  subject         String?
  qualification   String?
  experienceYears Int      @default(0) @map("experience_years") @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacySource    String?  @map("legacy_source")
  legacyId        String?  @map("legacy_id")

  @@unique([userId], map: "uq_teacher_profiles_user_id")
  @@unique([legacySource, legacyId], map: "uq_teacher_profiles_legacy")
  @@map("teacher_profiles")
}

// ------------------------------------------------------------------------------------------------------------------
// BE-18 (M10 part B): missions, remedial tests, teacher question sets and the teacher DSKP picking list. Written by
// hand in migration 0021_missions_question_sets (renumber at merge): identity columns, CHECK constraints and the
// foreign keys to users, subjects, chapters, education_levels and questions (not Prisma relations, see above).
// Data model section 3.9.

/// A teacher-assigned mission (DATA-M10-04). Recipients are stored at launch in `mission_items` (BR-M10-17).
/// Completion is derived from `practice_sessions.mission_id`, never stored.
model Mission {
  id              BigInt   @id @default(autoincrement())
  teacherId       BigInt   @map("teacher_id")
  /// The class the mission was launched for; null for a migrated or orphaned row.
  classroomId     BigInt?  @map("classroom_id")
  title           String
  /// latih_tubi, tracking_a, youtube (check constraint). The constant missionSource 'bank_soalan' is not stored.
  missionType     String   @map("mission_type")
  missionDate     DateTime @map("mission_date") @db.Date
  subjectId       BigInt   @map("subject_id")
  /// null = "Semua Bab".
  chapterId       BigInt?  @map("chapter_id")
  questionCount   Int      @map("question_count") @db.SmallInt
  coinsPerCorrect Int      @default(3) @map("coins_per_correct") @db.SmallInt
  resourceTitle   String?  @map("resource_title")
  resourceUrl     String?  @map("resource_url")
  resourceNote    String?  @map("resource_note")
  isTest          Boolean  @default(false) @map("is_test")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacySource    String?  @map("legacy_source")
  legacyId        String?  @map("legacy_id")

  items MissionItem[]

  @@unique([legacySource, legacyId], map: "uq_missions_legacy")
  @@index([teacherId, createdAt], map: "ix_missions_teacher_id_created_at")
  @@index([missionDate], map: "ix_missions_mission_date")
  @@map("missions")
}

/// One recipient of a mission (mock `recipientIds[]`, OQ-DM-10 interpretation).
model MissionItem {
  id        BigInt   @id @default(autoincrement())
  missionId BigInt   @map("mission_id")
  studentId BigInt   @map("student_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade, map: "fk_mission_items_mission_id")

  @@unique([missionId, studentId], map: "uq_mission_items_mission_id_student_id")
  @@index([studentId], map: "ix_mission_items_student_id")
  @@map("mission_items")
}

/// A remedial test generated by a teacher for one student (DATA-M10-09). Not migrated (no .cloud source).
/// Partial unique index uq_remedial_tests_open (teacher_id, student_id, subject_id) WHERE status = 'active' lives in
/// migration 0021 only (Prisma cannot express partial indexes): one open test per teacher, pupil and subject.
model RemedialTest {
  id             BigInt    @id @default(autoincrement())
  teacherId      BigInt    @map("teacher_id")
  studentId      BigInt    @map("student_id")
  subjectId      BigInt    @map("subject_id")
  totalQuestions Int       @map("total_questions") @db.SmallInt
  /// active, completed, cancelled (check constraint).
  status         String    @default("active")
  beforeAccuracy Decimal   @map("before_accuracy") @db.Decimal(5, 2)
  afterAccuracy  Decimal?  @map("after_accuracy") @db.Decimal(5, 2)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  isTest         Boolean   @default(false) @map("is_test")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items RemedialTestItem[]

  @@index([teacherId, createdAt], map: "ix_remedial_tests_teacher_id_created_at")
  @@index([studentId, status], map: "ix_remedial_tests_student_id_status")
  @@map("remedial_tests")
}

/// The questions of a remedial test in stored order (OD-28, OWN-7): the version served when generated.
model RemedialTestItem {
  id                BigInt @id @default(autoincrement())
  remedialTestId    BigInt @map("remedial_test_id")
  position          Int    @db.SmallInt
  questionId        BigInt @map("question_id")
  questionVersionNo Int    @map("question_version_no")

  remedialTest RemedialTest @relation(fields: [remedialTestId], references: [id], onDelete: Cascade, map: "fk_remedial_test_items_remedial_test_id")

  @@unique([remedialTestId, position], map: "uq_remedial_test_items_remedial_test_id_position")
  @@unique([remedialTestId, questionId], map: "uq_remedial_test_items_remedial_test_id_question_id")
  @@index([questionId], map: "ix_remedial_test_items_question_id")
  @@map("remedial_test_items")
}

/// A teacher question set for one class (DATA-M10-05). A migrated header keeps no items (Q4): `needs_rebuild`.
model QuestionSet {
  id               BigInt    @id @default(autoincrement())
  teacherId        BigInt    @map("teacher_id")
  /// Null only for a migrated header (`legacy_source` set, `needs_rebuild` true; Q4 A, AZ-31, check
  /// `ck_question_sets_classroom_or_migrated`). Such a set is never listed to a student or served until rebuilt.
  classroomId      BigInt?   @map("classroom_id")
  subjectId        BigInt?   @map("subject_id")
  title            String
  description      String?
  groupTag         String?   @map("group_tag")
  /// null = no limit.
  timeLimitMinutes Int?      @map("time_limit_minutes") @db.SmallInt
  /// 0 = unlimited.
  maxAttempts      Int       @default(1) @map("max_attempts") @db.SmallInt
  /// draft, scheduled, published (check constraint).
  status           String    @default("draft")
  scheduledAt      DateTime? @map("scheduled_at") @db.Timestamptz(6)
  needsRebuild     Boolean   @default(false) @map("needs_rebuild")
  isTest           Boolean   @default(false) @map("is_test")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacySource     String?   @map("legacy_source")
  legacyId         String?   @map("legacy_id")

  items QuestionSetItem[]

  @@unique([legacySource, legacyId], map: "uq_question_sets_legacy")
  @@index([classroomId, status], map: "ix_question_sets_classroom_id_status")
  @@index([teacherId, createdAt], map: "ix_question_sets_teacher_id_created_at")
  @@map("question_sets")
}

/// The questions of a set in stored order; a deactivated question is skipped when served, never deleted here.
model QuestionSetItem {
  id                BigInt @id @default(autoincrement())
  questionSetId     BigInt @map("question_set_id")
  position          Int    @db.SmallInt
  questionId        BigInt @map("question_id")
  questionVersionNo Int    @map("question_version_no")

  questionSet QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade, map: "fk_question_set_items_question_set_id")

  @@unique([questionSetId, position], map: "uq_question_set_items_question_set_id_position")
  @@unique([questionSetId, questionId], map: "uq_question_set_items_question_set_id_question_id")
  @@index([questionId], map: "ix_question_set_items_question_id")
  @@map("question_set_items")
}

/// Teacher DSKP picking list, level 1 (OWN-11: not the admin DSKP tree `curriculum_nodes`).
model DskpBidang {
  id               BigInt   @id @default(autoincrement())
  subjectId        BigInt   @map("subject_id")
  educationLevelId BigInt   @map("education_level_id")
  code             String?
  name             String
  /// null = seed.
  createdById      BigInt?  @map("created_by_id")
  isTest           Boolean  @default(false) @map("is_test")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sks DskpSk[]

  @@index([subjectId, educationLevelId], map: "ix_dskp_bidang_subject_id_education_level_id")
  @@map("dskp_bidang")
}

/// Teacher DSKP picking list, level 2 (Standard Kandungan).
model DskpSk {
  id          BigInt   @id @default(autoincrement())
  bidangId    BigInt   @map("bidang_id")
  code        String
  description String
  createdById BigInt?  @map("created_by_id")
  isTest      Boolean  @default(false) @map("is_test")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bidang DskpBidang @relation(fields: [bidangId], references: [id], onDelete: Cascade, map: "fk_dskp_sk_bidang_id")
  sps    DskpSp[]

  @@index([bidangId], map: "ix_dskp_sk_bidang_id")
  @@map("dskp_sk")
}

/// Teacher DSKP picking list, level 3 (Standard Pembelajaran).
model DskpSp {
  id          BigInt   @id @default(autoincrement())
  skId        BigInt   @map("sk_id")
  code        String
  description String
  createdById BigInt?  @map("created_by_id")
  isTest      Boolean  @default(false) @map("is_test")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sk DskpSk @relation(fields: [skId], references: [id], onDelete: Cascade, map: "fk_dskp_sp_sk_id")

  @@index([skId], map: "ix_dskp_sp_sk_id")
  @@map("dskp_sp")
}
