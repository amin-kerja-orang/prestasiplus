{
  "name": "@pp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PrestasiPlus v2 backend (NestJS 11, ESM). See docs/adr/0020-backend-stack.md.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:generate": "prisma generate",
    "predev": "npm run db:generate",
    "build": "vite build --config vite.build.config.ts",
    "prebuild": "npm run db:generate",
    "start": "node dist/main.js",
    "lint": "eslint --ignore-pattern \"dist/**\" --ignore-pattern \"src/db/generated/**\" .",
    "prelint": "npm run db:generate",
    "lint:migration": "tsx scripts/check-migratable.ts",
    "migrate:core": "tsx src/migration/load/cli.ts",
    "migrate:activity": "tsx src/migration/load/activity/cli.ts",
    "migrate:all": "tsx src/migration/orchestrate.ts migrate:all",
    "migrate:delta": "tsx src/migration/orchestrate.ts migrate:delta",
    "migrate:verify": "tsx src/migration/orchestrate.ts migrate:verify",
    "migrate:rollback": "tsx src/migration/orchestrate.ts migrate:rollback",
    "migrate:link-questions": "tsx src/migration/orchestrate.ts migrate:link-questions",
    "staging:ddl": "tsx src/migration/ddl/generate.ts",
    "staging:load": "tsx src/migration/staging/cli.ts staging:load",
    "staging:profile": "tsx src/migration/staging/cli.ts staging:profile",
    "anonymise:run": "tsx src/migration/anonymise/cli.ts anonymise:run",
    "anonymise:scan": "tsx src/migration/anonymise/cli.ts anonymise:scan",
    "fixtures:generate": "tsx src/migration/fixtures/cli.ts",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run db:generate",
    "test": "vitest run",
    "pretest": "npm run db:generate",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "db:seed": "node scripts/db.mjs seed"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "@pp/contract": "*",
    "@pp/exam-core": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "nestjs-pino": "5.3.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@pp/contract-tests": "*",
    "@swc/core": "1.15.47",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "^5.0.0",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.1",
    "yaml": "^2.9.1"
  }
}
