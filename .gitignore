.playwright-mcp/

# Dependencies
node_modules/

# Builds
dist/
dist-*/
*.local

# Test reports
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# TypeScript / tool caches
*.tsbuildinfo
.eslintcache
.vite/

# Logs
npm-debug.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Raw live captures and screenshots: local evidence only, may contain real personal data (privacy rule)
docs/discovery/inventory/_raw/
docs/discovery/img/

# Nuxt UI generated type declarations (V2-T02)
auto-imports.d.ts
components.d.ts

# Per-agent Playwright outputs
test-results-*/
playwright-report-*/

# Local compose overrides (see .env.example)
.env

# page-shots harness output (local only, D-H5)
.page-shots/

# Backend env files with secrets (BE-01; examples: .env.api.example)
.env.api
.env.db

# Local compose override (BE-02; example: compose.override.example.yaml)
compose.override.yaml
# Prisma client generated by `prisma generate` (BE-02)
apps/api/src/db/generated/

# Migration output and dumps never enter git (BE-34, BE-NFR-13)
.migration-out/
*.dump
*.sql.gz

# Local git worktrees created by agent sessions (never tracked)
.claude/worktrees/

# Production VPS pack (AZ-09): real env files live in /etc/pretasiplus on the server; never inside the repo
deploy/vps/prod.env
deploy/vps/api.env
deploy/vps/db.env
deploy/vps/.env.prod

# Screenshots of live systems (may contain personal data) - never commit
roles-matrix/**/*.jpeg
roles-matrix/**/*.jpg
roles-matrix/**/*.png
WhatsApp Image *
