# THROTTLE_BIJAK_GENERATE_PER_MINUTE=10   # Jana Kertas generation (BE-15), per user (429 above)
# THROTTLE_BIJAK_BUILDER_READ_PER_MINUTE=240   # paper builder and blueprint admin reads (BE-39), per Admin Pusat user
