# PrestasiPlus API environment (copy to .env.api, which is git-ignored). Placeholders only: never
# commit real values. Every active KEY= line is declared in apps/api/src/common/config/env.schema.ts
# (a test keeps the two in sync). Each lane adds its own keys ONLY inside its own block below, as
# commented lines (`# KEY=placeholder`) until the card that reads them lands, then uncomments them
# and adds them to the schema.

# ===== Foundation (BE-01, PC-1) =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ===== PC-1 Foundation to Identity (BE-02 to BE-07, BE-24, BE-33, BE-42, BE-46, BE-47) =====
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME
SESSION_COOKIE_NAME=pp_session
# Placeholder: REJECTED in production (the API refuses to start). Use a random value of 16+ characters.
SESSION_SECRET=change-me
SESSION_REMEMBER_DAYS=30   # remember-me lifetime in days
SESSION_REMEMBER_DAYS_STAFF=1   # same for admin and school_admin; 0 = remember is off for them
COOKIE_DOMAIN=
COOKIE_SECURE=true
# PUBLIC_BASE_URL=http://localhost:8080
# FILE_STORAGE_DIR=/var/lib/pretasiplus/files
# MAX_UPLOAD_MB=10
THROTTLE_LOGIN_PER_MINUTE=5
THROTTLE_PUBLIC_PER_MINUTE=60   # public lookups (jpn, ppd), per client address; set TRUST_PROXY_HOPS behind a proxy
THROTTLE_PUBLIC_SEARCH_PER_MINUTE=300   # public school typeahead, per client address (a school shares one)
THROTTLE_ADMIN_READ_PER_MINUTE=300   # admin reads, per user
THROTTLE_ADMIN_WRITE_PER_MINUTE=30   # admin writes, per user
THROTTLE_IMPORT_PER_HOUR=10   # bulk user imports, per user
IC_HASH_KEY=   # HMAC key of ic_hash. REQUIRED in production: min 32 chars, not equal to SESSION_SECRET. Outside production empty = SESSION_SECRET. NEVER rotate casually: it breaks every stored IC hash (IC lookups) until all are recomputed
TRUST_PROXY_HOPS=0   # reverse-proxy hops to trust for the client IP (0 = none)
ALLOW_DEMO_SEED=false   # true only in dev/test: lets the seed create the demo accounts
# SEED_DEMO_PASSWORD_HASH=

LEGACY_BCRYPT_DUMMY_COST=12   # cost (4..13) of the dummy bcrypt that evens out login timing
LOGIN_FAILURE_FLOOR_MS=1500   # a failed login never answers sooner than this (timing oracle); keep it above the dummy bcrypt time
LOGIN_IDENTIFIER_FAIL_LIMIT=100   # failed logins per 15 min for one identifier across all addresses

