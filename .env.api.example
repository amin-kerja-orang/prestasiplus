THROTTLE_BIJAK_ATTEMPT_SAVE_PER_MINUTE=240   # BE-16: autosave (PUT answers), per user
THROTTLE_BIJAK_ATTEMPT_WRITE_PER_MINUTE=30   # BE-16: start, submit, abandon, per user
THROTTLE_BIJAK_CHECK_PER_MINUTE=60   # BE-16: latihan "Semak", per user
THROTTLE_BIJAK_PHOTO_PER_MINUTE=20   # BE-16: working photo uploads, per user
BIJAK_SWEEP_INTERVAL_SECONDS=60   # BE-16: how often unattended exam attempts past deadline + 300 s are auto-submitted; 0 = off (and off by default under NODE_ENV=test)
# (no keys yet; add yours here)
