# ===== PC-4 Migration and ETL (BE-27 to BE-30, BE-34, BE-35) =====
# PP_ALLOW_MIGRATE_APPLY=1   # required for `--apply` of any migrate:* command (dry-run needs nothing)
# PP_MIGRATE_TARGET_DB=      # in production, `--apply` also needs this equal to current_database()
# CLOUD_SOURCE_URL=   # read-only source, migration only; a remote host needs ?sslmode=require
# PP_ALLOW_STAGING_RESET=1   # staging:load drops staging_cloud and archive_cloud; also needs a *_staging database
# PP_STAGING_DB_ALLOWLIST=   # optional: extra database names (comma separated) that staging:load may reset
# ANON_HMAC_KEY=             # anonymiser (LEAD only, real data): pseudonym key, 32+ characters. Never commit a value. Or use the file form:
# ANON_HMAC_KEY_FILE=        # path of a key file OUTSIDE the repo (mode 600); set exactly one of the two

# ===== PC-5 AI intake (BE-10, BE-36 to BE-38, BE-40, BE-43) =====
# --- BE-37 jobs, OCR and intake files (all optional; the values below are the defaults) ---
JOBS_WORKER_ENABLED=false   # true = this process claims and runs background jobs; false = it only enqueues (safe default; set true on exactly the worker instance)
JOBS_POLL_MS=1000   # job worker tick in ms
JOBS_CONCURRENCY=2   # jobs in flight per process
JOBS_LOCK_TIMEOUT_MS=600000   # a running job locked longer than this is re-queued by the sweeper
JOBS_BACKOFF_BASE_MS=5000   # retry delay = base * 2^(attempt-1), capped at 5 minutes
OCR_ENGINE=none   # none = no OCR (scanned pages end as OCR_UNAVAILABLE); tesseract = tesseract.js with local language data (never downloads)
OCR_LANG_DIR=   # empty = unset. Absolute folder holding msa.traineddata and eng.traineddata, e.g. /opt/tessdata; required when OCR_ENGINE=tesseract
OCR_WORKERS=2   # concurrent PDF/OCR worker threads
OCR_PAGE_TIMEOUT_MS=30000   # one page (text, render or OCR); a timeout fails only that page
OCR_INSPECT_TIMEOUT_MS=15000   # reading the page count of an upload
OCR_MAX_PAGES=200   # pages per PDF; more is rejected at upload
OCR_MIN_TEXT_CHARS=20   # a page with fewer text-layer characters counts as scanned
OCR_RENDER_DPI=150   # page image resolution
OCR_MAX_PIXELS=12000000   # cap of width x height of a rendered page
OCR_WORKER_MEMORY_MB=256   # heap limit of one PDF worker thread
OCR_WORKER_RSS_LIMIT_MB=512   # process RSS growth that stops a PDF worker (default 2 x OCR_WORKER_MEMORY_MB)
INTAKE_UPLOAD_CONCURRENCY=2   # upload requests inspecting PDFs at once in this process (others wait)
INTAKE_MAX_FILES_PER_BATCH=10   # files per upload request and per batch
INTAKE_MAX_ACTIVE_BATCHES=5   # open (submitted or processing) batches per teacher; admin exempt
INTAKE_DAILY_PAGE_QUOTA=500   # pages uploaded per user per day (Malaysia time); admin exempt
INTAKE_WRITES_PER_MINUTE=20   # create, upload and cancel per user (429 above)
INTAKE_READS_PER_MINUTE=240   # page, thumb, figure and original reads per user (429 above)
THROTTLE_CIKGU_SEND_PER_MINUTE=20   # Cikgu Alesa chat turns, per user per minute (429 RATE_LIMITED above; the DAILY turn quota is separate and fixed by role)
THROTTLE_CIKGU_READ_PER_MINUTE=120   # Cikgu Alesa RPH, essay and PBD queue reads, per user (429 above)
THROTTLE_CIKGU_WRITE_PER_MINUTE=30   # Cikgu Alesa RPH create, PBD roll-up and bulk approve, per user (429 above)
THROTTLE_CIKGU_EXPORT_PER_MINUTE=10   # Cikgu Alesa approved-PBD CSV export (bulk pupil names), per user (429 above)

# ===== PC-6 Teacher, Reports, Conformance and Seed (BE-17 to BE-22, BE-26, BE-31) =====
THROTTLE_CLASSES_READ_PER_MINUTE=300   # class and roster reads (Guru, Kelas Saya), per user (429 above)
THROTTLE_CLASSES_WRITE_PER_MINUTE=30   # class create, roster add/remove, inline chapter/topic writes, per user (429 above)
THROTTLE_CLASS_JOIN_PER_MINUTE=10   # join-by-code attempts, per user (the join code is a guessing target; 429 above)
PUBLIC_BASE_URL=http://localhost:8080   # public origin of the app; the QR join link of a class is PUBLIC_BASE_URL/kelas-saya?kod=CODE
THROTTLE_KIRKPATRICK_READ_PER_MINUTE=120   # Kirkpatrick levels, pupil views, interventions list, PDF, feedback status (pupil data, no-store), per user (429 above)
THROTTLE_KIRKPATRICK_WRITE_PER_MINUTE=30   # POST /kirkpatrick/interventions and POST /feedback, per user (429 above)
THROTTLE_ANALYTICS_READ_PER_MINUTE=120   # M11 monitoring and teacher report/item analysis (pupil data, no-store), per user (429 above)

