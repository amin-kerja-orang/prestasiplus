# PrestasiPlus API environment (copy to .env.api, which is git-ignored). Placeholders only: never
# commit real values. Every active KEY= line is declared in apps/api/src/common/config/env.schema.ts
# (a test keeps the two in sync). Each lane adds its own keys ONLY inside its own block below, as
# commented lines (`# KEY=placeholder`) until the card that reads them lands, then uncomments them
# and adds them to the schema.

# ===== Foundation (BE-01, PC-1) =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ===== PC-1 Foundation to Identity (BE-02 to BE-07, BE-24, BE-33, BE-42, BE-46, BE-47) =====
# DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME
# SESSION_COOKIE_NAME=pp_session
# SESSION_SECRET=change-me
# SESSION_TTL_HOURS=12
# SESSION_REMEMBER_DAYS=30
# COOKIE_DOMAIN=
# COOKIE_SECURE=true
# PUBLIC_BASE_URL=http://localhost:8080
# FILE_STORAGE_DIR=/var/lib/pretasiplus/files
# MAX_UPLOAD_MB=10
# THROTTLE_LOGIN_PER_MINUTE=5
# SEED_DEMO_PASSWORD_HASH=

