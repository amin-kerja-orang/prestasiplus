# PrestasiPlus API environment (copy to .env.api, which is git-ignored). Placeholders only: never
# commit real values. Every active KEY= line is declared in apps/api/src/common/config/env.schema.ts
# (a test keeps the two in sync). Each lane adds its own keys ONLY inside its own block below, as
# commented lines (`# KEY=placeholder`) until the card that reads them lands, then uncomments them
# and adds them to the schema.

# Real-API stack (BE-32): copy this file to .env.api and .env.db.example to .env.db, then replace every
# placeholder with a random value (for example `openssl rand -hex 32`; IC_HASH_KEY must differ from
# SESSION_SECRET) and use the .env.db user, password and database in DATABASE_URL. Then `npm run stack:up`.

# ===== Foundation (BE-01, PC-1) =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ===== PC-1 Foundation to Identity (BE-02 to BE-07, BE-24, BE-33, BE-42, BE-46, BE-47) =====
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME
SESSION_COOKIE_NAME=pp_session
# Placeholder: REJECTED in production (the API refuses to start). Use a random value of 16+ characters.
SESSION_SECRET=change-me
SESSION_REMEMBER_DAYS=30   # remember-me lifetime in days
SESSION_REMEMBER_DAYS_STAFF=1   # same for admin and school_admin; 0 = remember is off for them
COOKIE_DOMAIN=
COOKIE_SECURE=true
# PUBLIC_BASE_URL=http://localhost:8080
# FILE_STORAGE_DIR=/var/lib/pretasiplus/files   # REQUIRED in production (the API refuses to start without it); a named volume is mounted here (compose: apifiles, set in the Dockerfile). Outside production a temp folder is used.
MAX_UPLOAD_MB=10   # global ceiling of one upload; each purpose has a lower limit
INTAKE_MAX_FILE_MB=20   # ceiling of derived intake files (BE-37)
UPLOAD_RATE_PER_MINUTE=30   # uploads and file deletes per user per minute (429 above)
FILE_READS_PER_MINUTE=120   # file downloads per user per minute (anonymous cms_image reads: per address); 429 above
# Persistence check (manual, BE-04 AC 6): upload a file, then `docker compose down` and `up`: the file is still served; only `docker compose down -v` removes the apifiles volume and the files.
THROTTLE_LOGIN_PER_MINUTE=5
THROTTLE_PUBLIC_PER_MINUTE=60   # public lookups (jpn, ppd), per client address; set TRUST_PROXY_HOPS behind a proxy
THROTTLE_REGISTER_PER_MINUTE=30   # self-registration attempts, per client address (own bucket, separate from the login throttle; a school shares one address)
THROTTLE_PUBLIC_SEARCH_PER_MINUTE=300   # public school typeahead, per client address (a school shares one)
THROTTLE_ADMIN_READ_PER_MINUTE=300   # admin reads, per user
THROTTLE_ADMIN_WRITE_PER_MINUTE=30   # admin writes, per user
THROTTLE_IMPORT_PER_HOUR=10   # bulk user imports, per user
THROTTLE_PARENT_INVITE_PREVIEW_PER_MINUTE=30   # public invite preview, per client address
THROTTLE_PARENT_INVITE_READ_PER_MINUTE=120   # invite status and parent links reads, per user
THROTTLE_PARENT_INVITE_ISSUE_PER_HOUR=10   # new invite tokens, per student
THROTTLE_PARENT_INVITE_ACCEPT_PER_HOUR=30   # invite accepts, per parent
THROTTLE_PARENT_LINK_WRITE_PER_MINUTE=30   # unlinking, per user
THROTTLE_NOTIFICATION_READ_PER_MINUTE=240   # notification inbox reads and unread-count, per user
THROTTLE_NOTIFICATION_WRITE_PER_MINUTE=60   # notification read/delete writes, per user
THROTTLE_WALLET_READ_PER_MINUTE=240   # wallet, ledger and gamification-summary reads, per user
THROTTLE_SUPPORT_TICKET_CREATE_PER_HOUR=10   # support tickets created, per user per hour
THROTTLE_GAMIFICATION_CONVERT_PER_MINUTE=30   # syiling to token conversions, per user per minute
THROTTLE_SHOP_WRITE_PER_MINUTE=30   # rewards shop spends (Hadiah, Kotak Misteri, Cabutan tickets), per user per minute
THROTTLE_SUPPORT_READ_PER_MINUTE=120   # own tickets and the admin queue reads, per user
THROTTLE_SUPPORT_CONFIG_PER_MINUTE=60   # public support contact, per client address
THROTTLE_AUDIO_KBAT_READ_PER_MINUTE=120   # audio KBAT list and player data, per user
THROTTLE_AUDIO_KBAT_FILE_PER_MINUTE=60   # audio KBAT section audio (range requests), per user
THROTTLE_AUDIO_KBAT_ATTEMPT_PER_MINUTE=30   # audio KBAT attempt submits, per user
THROTTLE_AUDIO_KBAT_ADMIN_WRITE_PER_HOUR=20   # audio KBAT set creates (up to 80 MB each), per admin per hour
THROTTLE_PERFORMANCE_READ_PER_MINUTE=120   # Prestasi, Analitik and Analisa Item reads (pupil performance data, no-store), per user
THROTTLE_SCHOOL_ADMIN_READ_PER_MINUTE=120   # school dashboard and pending-teacher list, per user
THROTTLE_SCHOOL_ADMIN_WRITE_PER_MINUTE=30   # verify a pending teacher, per user
THROTTLE_SCHOOL_ADMIN_CREATE_PER_MINUTE=10   # create a teacher or pupil account, per user
THROTTLE_SCHOOL_ADMIN_RESET_PER_MINUTE=10   # reset a teacher or pupil password, per user
THROTTLE_SCHOOL_ADMIN_EXPORT_PER_MINUTE=5   # user CSV and Amaran CSV exports, per user
THROTTLE_GLOBAL_PER_MINUTE=300   # BE-33: ceiling per client address per minute on every /api route except /api/health (per process); per-route buckets stay stricter
IC_HASH_KEY=   # HMAC key of ic_hash. REQUIRED in production: min 32 chars, not equal to SESSION_SECRET. Outside production empty = SESSION_SECRET. NEVER rotate casually: it breaks every stored IC hash (IC lookups) until all are recomputed
TRUST_PROXY_HOPS=0   # reverse-proxy hops to trust for the client IP (0 = none). compose.yaml sets 1 for the api service (the frontend nginx is one hop); with a further load balancer in front use 2. A wrong value lets a client choose the address the throttles see (too high) or throttles everyone as one address (too low)
PUBLIC_ORIGINS=   # comma-separated web origins allowed in article/banner image URLs (BE-24); the API origin is always allowed
ALLOW_DEMO_SEED=false   # compose: only compose.http.yaml (dev/e2e) sets true for the one-off `migrate` job; never put true in a production .env.api. true only in dev/test: lets the seed create the demo accounts. In production `be:db:seed` with this false loads REFERENCE data only (the school_packages catalogue) and skips every demo module
# SEED_DEMO_PASSWORD_HASH=   # OPTIONAL, staging / production-demo ONLY: argon2id PHC string ($argon2id$v=19$m=19456,t=2,p=1$salt$hash) used as the password hash of EVERY demo account the seed creates. Unset (dev, e2e, tests) the published dev password Demo1234 is hashed instead, so on a public staging set this or anyone can log in as admin@demo.test. An invalid value makes the seed fail (the value is never printed). Accounts that already have a hash keep it: set it before the first seed, or reset those hashes on an already seeded database.
BIJAK_POC_QUESTIONS=false   # Bijak SPM PoC questions (reserved PoC id block: seeded PoC papers, Jana pool). STAGING/dev/e2e ONLY (LEAD decision 2026-10-20): set true wherever ALLOW_DEMO_SEED loads the demo seed; false in production serves BE-09 questions only

LEGACY_BCRYPT_DUMMY_COST=12   # cost (4..13) of the dummy bcrypt that evens out login timing
LOGIN_FAILURE_FLOOR_MS=1500   # a failed login never answers sooner than this (timing oracle); keep it above the dummy bcrypt time
LOGIN_IDENTIFIER_FAIL_LIMIT=100   # failed logins per 15 min for one identifier across all addresses
THROTTLE_ACCOUNT_WRITE_PER_MINUTE=30   # profile, password, picture and settings writes, per user (429 above)
THROTTLE_PRACTICE_WRITE_PER_MINUTE=120   # practice start, check-answer and submit, per user (429 above)
THROTTLE_PRACTICE_READ_PER_MINUTE=120   # practice history reads, per user (429 above)
THROTTLE_SPM_TARGETS_WRITE_PER_MINUTE=30   # PUT /spm-targets, per user (429 above)
THROTTLE_STRUCTURED_ATTEMPT_PER_MINUTE=60   # structured question attempts, per user (429 above)
THROTTLE_QUESTIONS_WRITE_PER_MINUTE=60   # question bank create, update, delete and bulk writes, per user (429 above)
MAIL_LOG_RESET_LINKS=false   # DEV ONLY. true prints the password reset link (a secret) to the log; read only when NODE_ENV=development; the API refuses to start in production with it true. No mail is ever sent in B1

