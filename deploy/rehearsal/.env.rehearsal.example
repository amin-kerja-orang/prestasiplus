# Rehearsal database settings (copy to deploy/rehearsal/.env.rehearsal, which is git-ignored).
# Placeholders only: never commit real values. Docker mode only; host mode uses PP_REHEARSAL_ADMIN_URL.
# Generate the password with:  openssl rand -hex 24      (hex only: it goes into a URL unescaped)
POSTGRES_USER=pp_rehearsal_admin
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=postgres

# Names and port (the script reads these too)
PP_REHEARSAL_DB=pp_rehearsal           # target database; <name>_staging and <name>_source are derived
PP_REHEARSAL_PORT=55433                # loopback only

# Postgres tuning: mirror the real production VPS (defaults assume 4 GB RAM / 2 vCPU)
# PP_PG_SHARED_BUFFERS=1GB
# PP_PG_EFFECTIVE_CACHE_SIZE=3GB
# PP_PG_WORK_MEM=16MB
# PP_PG_MAINTENANCE_WORK_MEM=256MB
# PP_PG_MAX_CONNECTIONS=100
# PP_PG_MAX_WAL_SIZE=2GB
# PP_PG_MIN_WAL_SIZE=256MB
# PP_PG_CHECKPOINT_TIMEOUT=15min
# PP_PG_RANDOM_PAGE_COST=1.1
# PP_PG_EFFECTIVE_IO_CONCURRENCY=200
# PP_PG_LOG_MIN_DURATION_STATEMENT=500ms
# PP_PG_SHM_SIZE=512mb
