# DATABASE_URL of the migration role pp_etl, used ONLY by `migrate:*` through `slot.sh etl` (cutover plan P3).
# Placeholders only. Real file: /etc/pretasiplus/etl.env (owner root, group ppdeploy, mode 640), never in git.
# Do not copy this file: `sudo deploy/vps/db-roles.sh secrets` creates it with a generated password (runbook section 3.1).
DATABASE_URL=postgresql://pp_etl:PASSWORD@db:5432/DBNAME
