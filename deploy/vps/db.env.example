# PostgreSQL service environment for production. Placeholders only. Real file: /etc/pretasiplus/db.env
# (root, mode 600), never in git. The api.env DATABASE_URL must use the same user, password and database.
# POSTGRES_PASSWORD applies only when the data directory is first created; changing it later needs ALTER ROLE
# (runbook section 13).
POSTGRES_DB=prestasiplus
POSTGRES_USER=pp
POSTGRES_PASSWORD=change-me
