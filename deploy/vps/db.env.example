# PostgreSQL service environment for production. Placeholders only. Real file: /etc/pretasiplus/db.env
# (owner root, group ppdeploy, mode 640), never in git.
# POSTGRES_USER is the BOOTSTRAP SUPERUSER of the cluster. Only the ops scripts use it, inside the db container
# (db-roles.sh, backup.sh, restore-drill.sh, a manual restore). The API, the migrate job and the ETL never do: they use
# pp_app, pp_owner and pp_etl (cutover plan P3; deploy/vps/db-roles.sh; runbook section 3.1). It must not be one of
# those names, and the DATABASE_URL files must not reuse POSTGRES_PASSWORD.
# POSTGRES_PASSWORD applies only when the data directory is first created; changing it later needs ALTER ROLE
# (runbook section 12).
POSTGRES_DB=prestasiplus
POSTGRES_USER=pp
POSTGRES_PASSWORD=change-me
