# PrestasiPlus production VPS: compose interpolation variables (AZ-09). Placeholders only.
# Real file: /etc/pretasiplus/prod.env (owner root, group ppdeploy, mode 640), created by the LEAD on the server, never in git.
# Used as `--env-file` by deploy/vps/*.sh and by `docker compose config`. Secrets for the app live in api.env
# and db.env (see api.env.example and db.env.example); the only semi-secret value here is a ping URL.
# Runbook and parameter table: docs/ops/production-vps.md

# ---- Identity (LEAD sets) ----
# public host name, no scheme. DNS A record must point at the VPS (the edge listens on IPv4 only; no AAAA record)
PP_DOMAIN=app.example.my
# expiry notices from Let's Encrypt (a real mailbox)
PP_LETSENCRYPT_EMAIL=ops@example.my

# ---- Where things live on the VPS ----
# holds prod.env, api.env, db.env
PP_ENV_DIR=/etc/pretasiplus
# certificates (certbot writes, edge reads)
PP_LE_DIR=/srv/pretasiplus/letsencrypt
PP_LE_LOG_DIR=/srv/pretasiplus/letsencrypt-log
PP_WEBROOT_DIR=/srv/pretasiplus/certbot-webroot
# dumps, OUTSIDE the repo, on an encrypted volume
PP_BACKUP_DIR=/var/backups/pretasiplus
# image tag history for rollback
PP_STATE_DIR=/var/lib/pretasiplus-deploy

# ---- Images ----
# deploy.sh overrides it with the git sha; rollback.sh with the previous one
PP_IMAGE_TAG=prod
# empty = build on the VPS. Registry example: ghcr.io/ORG/  (note the trailing slash)
PP_IMAGE_PREFIX=
# local = docker compose build on the VPS (needs ~2 GB free RAM) | pull = pull from PP_IMAGE_PREFIX
PP_BUILD_MODE=local
# comma list of compose profiles to run: monitoring (tls is used on demand). clamav is NOT a profile any more: it always runs
PP_PROFILES=

# ---- Network ----
# address for ports 80/443
PP_HTTP_BIND=0.0.0.0

# ---- Resource limits (VPS-agnostic defaults, fit a 4 vCPU / 8 GB box; see the sizing table in the runbook) ----
PP_API_CPUS=1.5
PP_API_MEM=2g
# Node old-space limit, keep it about 75% of PP_API_MEM
PP_API_HEAP_MB=1536
# keep above SHUTDOWN_GRACE_MS (25000) in api.env
PP_API_STOP_GRACE=35s
PP_DB_CPUS=2
PP_DB_MEM=2g
PP_DB_SHM=256m
PP_FRONTEND_CPUS=0.25
PP_FRONTEND_MEM=128m
PP_EDGE_CPUS=0.5
PP_EDGE_MEM=256m
PP_MIGRATE_CPUS=1
PP_MIGRATE_MEM=1g
PP_CLAMAV_CPUS=1
PP_CLAMAV_MEM=2g
PP_KUMA_CPUS=0.5
PP_KUMA_MEM=512m
# loopback only
PP_KUMA_PORT=3001

# ---- Postgres tuning (shared_buffers about 25% of the RAM given to the db container; keep PP_DB_MEM above shared_buffers + 50%) ----
PP_PG_SHARED_BUFFERS=512MB
PP_PG_EFFECTIVE_CACHE_SIZE=1GB
PP_PG_WORK_MEM=8MB
PP_PG_MAINTENANCE_WORK_MEM=128MB
# the API pool is 10 connections per process, plus migrate and backup
PP_PG_MAX_CONNECTIONS=100
PP_PG_MAX_WAL_SIZE=2GB
PP_PG_LOG_MIN_DURATION_MS=1000

# ---- Edge nginx ----
# POST /api/files: max(MAX_UPLOAD_MB, INTAKE_MAX_FILE_MB) + overhead
PP_UPLOAD_FILES_MB=22
# multipart routes with many files (intake batches 11 x 20 MB, audio KBAT 4 x 20 MB, ...)
PP_UPLOAD_BIG_MB=256
# documentation only; switch with deploy/vps/nginx/snippets/csp-*.conf (decision D-7)
PP_CSP_MODE=report-only
# space-separated https origins allowed for images in the CSP, e.g. https://img.youtube.com https://cdn.example.my
PP_CSP_IMG_HOSTS=https://img.youtube.com
# HSTS for the whole host, sent by the edge on every https response (the API's own header is replaced). Browsers
# cache it for max-age seconds, so RAMP it (docs/ops/platform-settings.md section 4.3): max-age=300 at first deploy,
# max-age=86400 after a clean week, then max-age=15552000. Add "; includeSubDomains" only after the LEAD confirms
# every subdomain of the domain serves HTTPS. Empty = no HSTS header.
PP_HSTS=max-age=300

# Per-IP flood guard on /api/auth/ at the edge. SECONDARY to the API's own login throttle; many schools share one NAT
# address, so keep it generous. Use a huge rate (for example 100000r/m) to make it a no-op.
PP_EDGE_AUTH_RATE=60r/m
PP_EDGE_AUTH_BURST=60

# ---- Locking ----
# one lock shared by backup, deploy, rollback, restore drill and certificate jobs (the deploy user must be able to write it)
PP_LOCK_FILE=/var/lock/pretasiplus.lock
# group the lock file is handed to when a script runs as root (sudo init-cert.sh); also install systemd/pretasiplus.tmpfiles.conf
PP_DEPLOY_GROUP=ppdeploy
# seconds a timer-started backup or drill waits for a running deploy before giving up
PP_LOCK_WAIT=1800

# ---- Image pins (optional; the defaults are in compose.prod.yaml) ----
# PP_EDGE_IMAGE=nginx:1.28-alpine
# PP_CERTBOT_IMAGE=certbot/certbot:v3.0.1
# PP_CLAMAV_IMAGE=clamav/clamav:1.4
# PP_KUMA_IMAGE=louislam/uptime-kuma:1.23.16

# ---- Logs ----
PP_LOG_MAX_SIZE=20m
PP_LOG_MAX_FILE=5

# ---- API runtime switches that live outside api.env ----
# exactly one API instance runs the job worker; this stack has one instance
PP_JOBS_WORKER_ENABLED=true

# ---- Backups (deploy/vps/backup) ----
PP_BACKUP_KEEP_DAILY=7
PP_BACKUP_KEEP_WEEKLY=4
# ISO weekday (1=Mon .. 7=Sun) whose dump is promoted to the weekly set
PP_BACKUP_WEEKLY_DAY=7
# pre-deploy and drill dumps kept (newest N of each kind)
PP_BACKUP_KEEP_AUX=5
# nothing older than this stays on the server (erasure rule, LEAD decision; 0 = off)
PP_BACKUP_MAX_AGE_DAYS=35
# archive the apifiles volume (uploads): true = every nightly run | weekly = only on PP_BACKUP_WEEKLY_DAY | false
PP_BACKUP_FILES=weekly
# uploads archives kept (newest N)
PP_BACKUP_KEEP_FILES=2
# s3 | rsync | none  (none is accepted only until the LEAD names a target)
PP_OFFSITE_KIND=none
# s3: any S3-compatible store. Credentials come from the aws CLI environment/profile of the backup user, never from this file.
# s3://bucket/prefix
PP_OFFSITE_S3_URI=
# https://s3.example-provider.com (empty = AWS)
PP_OFFSITE_S3_ENDPOINT=
# aws CLI profile name (optional)
PP_OFFSITE_S3_PROFILE=
# rsync over ssh: key-based, the key belongs to the backup user, NOT stored here.
# user@host:/path/
PP_OFFSITE_RSYNC_TARGET=
PP_OFFSITE_RSYNC_SSH_PORT=22
# true only as a recorded LEAD decision: lets off-site copies leave unencrypted
PP_OFFSITE_ALLOW_PLAINTEXT=false
# gpg public key id/email: REQUIRED when PP_OFFSITE_KIND is s3 or rsync. The PRIVATE key is kept off the server
PP_BACKUP_GPG_RECIPIENT=
# RECOMMENDED: 40-hex fingerprint of that key (gpg --fingerprint). Pins the exact key; takes precedence over the user id
PP_BACKUP_GPG_FPR=

# ---- Monitoring and alerts ----
# healthchecks.io-style dead man's switch pinged by the backup job (/start, success, /fail)
PP_HEALTHCHECK_PING_URL=
# second check pinged by the 5-minute health probe
PP_HEALTHCHECK_PROBE_URL=
# optional: generic webhook (ntfy, Slack-compatible) that receives a text body on any alert
PP_ALERT_WEBHOOK_URL=
# alert when a filesystem holding data/backups is fuller than this
PP_ALERT_DISK_PCT=85
# alert when the certificate expires in fewer days
PP_ALERT_CERT_DAYS=21
# alert when the newest dump is older than this
PP_ALERT_BACKUP_MAX_AGE_H=30
# API error lines (pino level 50) in 5 minutes that raise an alert
PP_ALERT_API_ERRORS_5M=25

# ---- Upload malware scan (AZ-188) ----
# MALWARE_SCAN=clamd, CLAMAV_HOST=clamav and CLAMAV_PORT=3310 are FORCED by compose.prod.yaml (the clamav service
# always runs). Do NOT set them here or in api.env: they are ignored and deploy.sh warns. Only the optional
# CLAMAV_TIMEOUT_MS (default 30000) may go in api.env. Runbook: docs/ops/production-vps.md section 15.
