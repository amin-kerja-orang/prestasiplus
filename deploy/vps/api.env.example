# PrestasiPlus production API environment. Placeholders only. Real file: /etc/pretasiplus/api.env
# (owner root, group ppdeploy, mode 640), never in git. Only the keys that NEED a production value are listed; every other key
# keeps the default of apps/api/src/common/config/env.schema.ts (full list: .env.api.example, runbook section 2).
# deploy/vps/compose.prod.yaml FORCES these (they win over this file): NODE_ENV=production,
# TRUST_PROXY_HOPS=1, COOKIE_SECURE=true, ALLOW_DEMO_SEED=false, BIJAK_POC_QUESTIONS=false,
# JOBS_WORKER_ENABLED, PUBLIC_BASE_URL, FILE_STORAGE_DIR. deploy.sh refuses a file that sets the two seed
# flags to true or still contains a placeholder.

# User, password and database MUST equal db.env. URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME
# 32+ random characters each, different from each other: openssl rand -hex 32
SESSION_SECRET=change-me
IC_HASH_KEY=change-me
# NEVER rotate IC_HASH_KEY casually: it breaks every stored IC hash (runbook section 13).

# Extra web origins allowed in article/banner image URLs (comma separated). Empty = only the API origin.
PUBLIC_ORIGINS=

# wa.me number of PLATFORM marketplace products (digits, country code first). The dev default 60000000000 is refused by deploy.sh.
MARKETPLACE_PLATFORM_WHATSAPP=change-me

LOG_LEVEL=info

# Self-registration (REG-CLOSE). false until go-live: POST /api/auth/register answers 403 REGISTRATION_CLOSED. Open it at the
# 30 Oct switch (REGISTRATION_OPEN=true, then recreate api; docs/ops/production-vps.md section 16). Unset = open, so keep the key.
REGISTRATION_OPEN=false

# Metrics: the edge answers 404 for /api/metrics from the internet. Leave METRICS_INTERNAL_CIDRS empty
# (production then allows an admin session only) unless a scraper joins the compose network.
METRICS_ENABLED=true
METRICS_INTERNAL_CIDRS=

# Runtime (defaults shown; the edge timeouts in deploy/vps/nginx are built around them)
KEEP_ALIVE_TIMEOUT_MS=65000
REQUEST_TIMEOUT_MS=120000
SHUTDOWN_GRACE_MS=25000

# AI intake (BE-36). DECIDED (AZ-29 item 1, LEAD 22 Oct): MOCK at go-live, no external AI, nothing leaves the server.
# Leave AI_MODEL, AI_API_KEY, AI_MONTHLY_BUDGET_SEN and AI_PRICE_TABLE_JSON UNSET; a paid provider needs a new LEAD decision
# (docs/ops/ai-intake-production-decisions.md). Intake limits: AZ-29 item 5 KEEP = schema defaults, so no INTAKE_* key here.
AI_PROVIDER=mock

# OCR (scanned PDFs). DECIDED (AZ-29 item 4): OFF at go-live; scanned pages end as OCR_UNAVAILABLE and are typed in by hand.
# Do not set OCR_LANG_DIR. tesseract only after a timed run of 20 real scans on this VPS and a new LEAD decision.
OCR_ENGINE=none

# Global ceiling per client ADDRESS per minute on every /api route (finding F2). Default applied 22 Oct (LEAD may veto):
# 3000, because a whole school shares one NAT address (about 250 active pupils at 12 requests per minute each).
# Per-user and per-route buckets stay at their stricter defaults. The schema default (300) would 429 a class of 40.
THROTTLE_GLOBAL_PER_MINUTE=3000

# Edge client address headers are NOT used on this stack (the edge nginx is the single proxy).
# CLIENT_IP_HEADER=
# EDGE_PROXY_SECRET=
