# Restore drill. STOPS THE API for the duration (about 1-3 minutes) to make the row-count comparison exact.
# Node 22 must be installed on the host. Enable the timer only after the first manual drills passed.
[Unit]
Description=PrestasiPlus restore drill (stops the api briefly)
After=docker.service
Requires=docker.service
OnFailure=pp-alert@%n.service

[Service]
Type=oneshot
User=ppdeploy
Group=ppdeploy
Environment=PP_ENV_DIR=/etc/pretasiplus
Environment=PP_OPERATOR=scheduled-drill
WorkingDirectory=/opt/pretasiplus
ExecStart=/opt/pretasiplus/deploy/vps/backup/restore-drill.sh
TimeoutStartSec=3h
