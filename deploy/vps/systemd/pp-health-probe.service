[Unit]
Description=PrestasiPlus health probe
After=docker.service

[Service]
Type=oneshot
User=ppdeploy
Group=ppdeploy
Environment=PP_ENV_DIR=/etc/pretasiplus
WorkingDirectory=/opt/pretasiplus
ExecStart=/opt/pretasiplus/deploy/vps/monitoring/health-probe.sh --quiet
TimeoutStartSec=2min
# Hardening that is compatible with using the docker CLI (the docker socket stays reachable; the socket is the real
# privilege, see the runbook). Paths with a leading "-" are skipped when absent. Change them with PP_BACKUP_DIR /
# PP_STATE_DIR / PP_LOCK_FILE.
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=-/var/backups/pretasiplus -/var/lib/pretasiplus-deploy -/run/lock
