# Nightly backup. Install: see docs/ops/production-vps.md section 9. Paths assume the checkout is /opt/pretasiplus
# and the deploy user is ppdeploy (member of the docker group); edit both if yours differ.
[Unit]
Description=PrestasiPlus database backup
After=docker.service
Requires=docker.service
OnFailure=pp-alert@%n.service

[Service]
Type=oneshot
User=ppdeploy
Group=ppdeploy
Environment=PP_ENV_DIR=/etc/pretasiplus
WorkingDirectory=/opt/pretasiplus
ExecStart=/opt/pretasiplus/deploy/vps/backup/backup.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
# Hardening that is compatible with using the docker CLI (the docker socket stays reachable; the socket is the real
# privilege, see the runbook). Paths with a leading "-" are skipped when absent. Change them with PP_BACKUP_DIR /
# PP_STATE_DIR / PP_LOCK_FILE.
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=-/var/backups/pretasiplus -/var/lib/pretasiplus-deploy -/run/lock
