# Cron alternative to the systemd timers (install ONE of the two, never both).
#   sudo install -m 644 deploy/vps/systemd/cron.pretasiplus /etc/cron.d/pretasiplus
# Paths assume the checkout is /opt/pretasiplus and the deploy user is ppdeploy. Server time zone:
# Asia/Kuala_Lumpur. Output goes to /var/log/pretasiplus/*.log (rotated by deploy/vps/logrotate/pretasiplus).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PP_ENV_DIR=/etc/pretasiplus

# m h dom mon dow user command
15 2 * * *   ppdeploy /opt/pretasiplus/deploy/vps/backup/backup.sh >>/var/log/pretasiplus/backup.log 2>&1 || /opt/pretasiplus/deploy/vps/monitoring/alert.sh "cron: backup failed"
*/5 * * * *  ppdeploy /opt/pretasiplus/deploy/vps/monitoring/health-probe.sh --quiet >>/var/log/pretasiplus/probe.log 2>&1
40 3,15 * * * ppdeploy /opt/pretasiplus/deploy/vps/tls/renew.sh >>/var/log/pretasiplus/cert-renew.log 2>&1
# Monthly drill (stops the api for 1-3 minutes). Uncomment after the first manual drills passed.
#30 3 1 * *  ppdeploy PP_OPERATOR=scheduled-drill /opt/pretasiplus/deploy/vps/backup/restore-drill.sh >>/var/log/pretasiplus/drill.log 2>&1
