# DATABASE_URL of the schema owner pp_owner, used ONLY by the one-shot `migrate` service (prisma migrate deploy, the
# reference seed). Placeholders only. Real file: /etc/pretasiplus/migrate.env (owner root, group ppdeploy, mode 640),
# never in git. Do not copy this file: `sudo deploy/vps/db-roles.sh secrets` creates it with a generated password
# (runbook section 3.1).
DATABASE_URL=postgresql://pp_owner:PASSWORD@db:5432/DBNAME
