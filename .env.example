# Copy to .env (git-ignored) to override compose defaults. No secrets belong here.
FRONTEND_PORT=5192
BUILD_MODE=demo
VITE_API_MODE=mock
VITE_TEST_HOOKS=false
VITE_PROTOTYPE_SCOPE=on
VITE_MOCK_LATENCY_MS=400
# ALESA AI / Cikgu Alesa surfaces are hidden until a real AI provider is wired (D73). Set to on to show them.
VITE_ALESA_AI=off
# Mohon Keluarga Angkat (M21 S6) is hidden for now (D74). Set to on to show the menu item and the route.
VITE_KELUARGA_ANGKAT=off
# Admin Pusat central views of the school reports (M17 R1-ADM-M-07, /admin/laporan-sekolah/*) are hidden for now. Set to on to register the routes.
VITE_CENTRAL_REPORTS=off
# Real API later (VITE_API_MODE=http): leave empty for same-origin /api
VITE_API_BASE_URL=

# ---- Real API stack (BE-32): npm run stack:up  (compose.http.yaml; needs .env.api and .env.db) ----
# The overlay builds the frontend with VITE_API_MODE=http and runs migrate + the demo seed (dev/e2e only).
# Cookie Secure flag of the dev/e2e stack (plain http on localhost). Production keeps the API default (true).
COOKIE_SECURE=false
# Login throttle of the dev/e2e api (the API default is 5 per minute per address; e2e logs in many times)
E2E_THROTTLE_LOGIN_PER_MINUTE=200
# Playwright real-API run (playwright.http.config.ts). Empty = http://localhost:$FRONTEND_PORT
BASE_URL=
# 1 = let Playwright start the stack itself (otherwise run npm run stack:up first)
E2E_HTTP_START_STACK=

# SPM hub (BE-41): seconds to cache per-subject SPM pool facts (0 = off)
SPM_POOL_CACHE_SECONDS=300

# Public login-page counters (GET /public/stats): seconds to reuse the counted figures (0 = count on every request)
PUBLIC_STATS_CACHE_SECONDS=120

# SPM hub (BE-41): simulated walkthrough delay in ms
SPM_WALKTHROUGH_DELAY_MS=1500
# SPM hub (BE-41): per-user ceilings per minute on POST /api/spm-mocks and POST /api/spm-walkthrough/solve
THROTTLE_SPM_MOCK_CREATE_PER_MINUTE=10
THROTTLE_SPM_WALKTHROUGH_PER_MINUTE=6

# ClamAV scan of intake uploads (DOCX, XLSX, PDF; teacher and admin), backlog #78. Required when INTAKE_TEACHER_ENABLED=true or CLAMAV_HOST is set:
# an infected file is refused (422, audit event intake.file_infected); an unreachable or slow scanner refuses the upload (503, fail closed).
CLAMAV_HOST=          # clamd host; production: clamav (compose profile clamav). Empty = no scanner
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_MAX_STREAM_MB=32   # = clamd StreamMaxLength; boot fails if INTAKE_MAX_FILE_MB is larger

# ---- UAT/production ops only (deploy/vps; these are read from /etc/pretasiplus/prod.env or the operator's shell, never by the app) ----
# migrate:verify per-run allowlist of reject reasons accepted as explained: comma list of entity|reason|column=maxN (no wildcard; more than N rejects
# of that kind fails again). ONE-RUN waiver: set it in the shell of the command, for that run only. slot.sh reads it from the process environment ONLY
# and refuses to run migrate:verify when prod.env (or any persisted env file) carries the key. Every run that uses it prints a WARNING; the report lists it.
# Leave unset unless the PO accepts a reject kind for this run. Example, for one run:
#   PP_VERIFY_ACCEPT_REJECTS='exam_questions|INVALID_VALUE|stem=3' deploy/vps/migration/slot.sh etl migrate:verify
#PP_VERIFY_ACCEPT_REJECTS=exam_questions|INVALID_VALUE|stem=3
# Same, one item (also =maxN) per line in a file (# comments); a HOST path outside the repo, readable by the migrate user. slot.sh mounts it read-only.
#PP_VERIFY_ACCEPT_REJECTS_FILE=/srv/pretasiplus/accept-rejects.txt
