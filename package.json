{
  "name": "prestasiplus-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "e2e:bijak:regression": "bash scripts/bijak-regression.sh",
    "e2e:bijak:http-dryrun": "bash scripts/bijak-http-dryrun.sh",
    "smoke:bijak": "node e2e/smoke/bijak-smoke.mjs",
    "build": "vue-tsc -b && vite build --mode demo && node scripts/check-demo-bundle.mjs",
    "build:artifact": "vue-tsc -b && node scripts/build-artifact.mjs",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "node scripts/lint.mjs",
    "lint:ds": "node scripts/lint-ds.mjs",
    "lint:ds:css": "node scripts/lint-ds-css.mjs",
    "lint:admin": "node scripts/lint-admin.mjs",
    "lint:admin:report": "node scripts/lint-admin.mjs --report",
    "lint:admin:baseline": "node scripts/lint-admin.mjs --write-baseline",
    "report:e2e-class-selectors": "node scripts/report-e2e-class-selectors.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:edge": "node --experimental-strip-types --test scripts/edge-worker.test.mjs",
    "test:perf": "vitest run --project perf",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:http": "playwright test -c playwright.http.config.ts",
    "stack:up": "docker compose -f compose.yaml -f compose.http.yaml up -d --build --wait",
    "stack:down": "docker compose -f compose.yaml -f compose.http.yaml down",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-check": "node scripts/db-restore-check.mjs",
    "test:e2e:bijak": "playwright test -c playwright.bijak.config.mjs --grep @bijak",
    "test:e2e:observed": "playwright test --grep-invert @provisional",
    "test:e2e:module": "node scripts/e2e-module.mjs",
    "check:trace": "node scripts/check-e2e-trace.mjs",
    "contract:emit": "npm run emit -w @pp/contract",
    "contract:check": "npm run check -w @pp/contract",
    "conformance": "npm run test:mock -w @pp/contract-tests",
    "conformance:api": "npm run be:test -- test/conformance",
    "be:dev": "npm run dev -w @pp/api",
    "be:build": "npm run build -w @pp/api",
    "be:lint": "npm run lint -w @pp/api",
    "be:lint:migration": "npm run lint:migration -w @pp/api",
    "be:typecheck": "npm run typecheck -w @pp/api",
    "be:test": "npm run test -w @pp/api --",
    "be:db:migrate": "npm run db:migrate -w @pp/api --",
    "be:db:reset": "npm run db:reset -w @pp/api --",
    "be:db:seed": "npm run db:seed -w @pp/api --",
    "contract:test": "vitest run --project unit packages/contract",
    "be:verify": "npm run contract:check && npm test -w @pp/contract-tests && npm run be:lint && npm run be:lint:migration && npm run be:typecheck && npm run be:test && npm run be:build",
    "ds:debt": "node scripts/ds-debt.mjs",
    "ds:census": "node scripts/codemods/census.mjs",
    "page-shots": "node scripts/page-shots.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/ph": "^1.2.2",
    "@lucide/vue": "^1.48.0",
    "@nuxt/ui": "^4.12.0",
    "@pp/contract": "*",
    "@pp/exam-core": "*",
    "chart.js": "^4.5.1",
    "html2canvas": "1.4.1",
    "idb-keyval": "^6.3.0",
    "katex": "^0.19.0",
    "pdfjs-dist": "6.4.299",
    "pinia": "^3.0.4",
    "tesseract.js": "7.0.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@swc/core": "1.15.47",
    "multer": "2.5.0"
  }
}
