{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["src/**/*.ts", "__tests__/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "lib": ["ES2023"],
    "types": ["node"]
  }
}
