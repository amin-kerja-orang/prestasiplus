{
  "name": "@pp/exam-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript exam engine shared by the Bijak SPM UI and the API (BE-14, ADR-0021): marking, maths expressions, blueprint composition, paper model.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./grading": "./src/grading.ts",
    "./math-expr": "./src/math-expr.ts",
    "./blueprint": "./src/blueprint.ts",
    "./paper-model": "./src/paper-model.ts",
    "./choose-n": "./src/choose-n.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run --root ../.. --project unit packages/exam-core",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.27.7"
  }
}
