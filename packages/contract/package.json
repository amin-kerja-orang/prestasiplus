{
  "name": "@pp/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-first API schemas (zod) and generated OpenAPI 3.1 shared by the frontend, the mock and the future NestJS backend (ADR-0018).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "emit": "jiti scripts/emit-openapi.ts",
    "check": "jiti scripts/emit-openapi.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  }
}
