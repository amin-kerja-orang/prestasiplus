{
  "name": "@pp/contract-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transport-agnostic contract conformance suite (BE-31, ADR-0018 item 5): scenarios written against a minimal HttpClient, run against the frontend mock now and the NestJS API later, plus the OpenAPI breaking-change gate.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project unit packages/contract-tests",
    "test:mock": "vitest run --config packages/contract-tests/vitest.conformance.config.ts --root ../.. --disableConsoleIntercept",
    "typecheck": "tsc -p tsconfig.check.json",
    "contract:diff": "node scripts/contract-diff.mjs",
    "contract:diff:samples": "node scripts/contract-diff.mjs --samples"
  },
  "dependencies": {
    "@pp/contract": "*",
    "zod": "4.6.5"
  }
}
